# ParcelPilot LLM Provider Configuration Example
# Copy this file to .env and configure your keys (or leave blank to run in offline deterministic mode)

# Primary LLM Provider API Key (Get a free key at: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Primary LLM Model Identifier (Default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Secondary Fallback LLM Provider API Key (Get a free key at: https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Secondary Fallback LLM Model Identifier (Default: nvidia/nemotron-3-nano-30b-a3b)
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
